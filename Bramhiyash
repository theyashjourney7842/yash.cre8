<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>BRAMHI YASH WINTER ARC — 90 Day Tracker</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

:root{
    --bg:#080808;
    --card:#111;
    --card2:#171717;
    --border:#292929;
    --text:#f5f5f5;
    --muted:#888;
    --orange:#ff4d00;
    --orange2:#ff7a00;
    --green:#31d158;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    background:var(--bg);
    color:var(--text);
    min-height:100vh;
}

.container{
    width:min(1200px,92%);
    margin:auto;
}

/* HEADER */

header{
    padding:24px 0;
    border-bottom:1px solid var(--border);
}

.nav{
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.logo{
    font-size:22px;
    font-weight:900;
    letter-spacing:2px;
}

.logo span{
    color:var(--orange);
}

.reset{
    padding:9px 15px;
    background:transparent;
    border:1px solid #333;
    color:#aaa;
    border-radius:8px;
    cursor:pointer;
}

.reset:hover{
    border-color:var(--orange);
    color:white;
}

/* HERO */

.hero{
    padding:65px 0 45px;
}

.eyebrow{
    color:var(--orange);
    font-size:12px;
    font-weight:bold;
    letter-spacing:3px;
    margin-bottom:15px;
}

.hero h1{
    font-size:clamp(50px,8vw,95px);
    line-height:.9;
    letter-spacing:-5px;
}

.hero h1 span{
    color:var(--orange);
}

.hero p{
    margin-top:20px;
    max-width:600px;
    color:var(--muted);
    line-height:1.6;
}

/* PERSON SWITCHER */

.person-switcher{
    display:flex;
    gap:10px;
    margin-bottom:30px;
}

.person-btn{
    padding:12px 22px;
    border:1px solid #333;
    background:#111;
    color:#777;
    border-radius:8px;
    cursor:pointer;
    font-weight:bold;
}

.person-btn.active{
    background:var(--orange);
    border-color:var(--orange);
    color:white;
}

/* SECTION */

.section-title{
    color:#999;
    font-size:12px;
    text-transform:uppercase;
    letter-spacing:2px;
    margin-bottom:14px;
}

/* DAY SELECTOR */

.day-grid{
    display:grid;
    grid-template-columns:repeat(15,1fr);
    gap:6px;
}

.day{
    height:35px;
    background:#111;
    border:1px solid #292929;
    border-radius:6px;
    color:#777;
    cursor:pointer;
}

.day:hover{
    border-color:var(--orange);
    color:white;
}

.day.active{
    background:var(--orange);
    border-color:var(--orange);
    color:white;
}

.day.completed{
    background:#16351e;
    border-color:#267b38;
    color:var(--green);
}

.day.active.completed{
    background:var(--orange);
    color:white;
}

/* DASHBOARD */

.dashboard{
    display:grid;
    grid-template-columns:1.3fr .7fr;
    gap:20px;
    margin-top:30px;
}

.card{
    background:var(--card);
    border:1px solid var(--border);
    border-radius:15px;
    padding:25px;
}

.card-title{
    color:#999;
    font-size:12px;
    text-transform:uppercase;
    letter-spacing:2px;
    margin-bottom:15px;
}

.day-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:25px;
}

.day-number{
    font-size:38px;
    font-weight:900;
}

.date{
    color:#777;
    font-size:13px;
}

/* HABITS */

.habits{
    display:flex;
    flex-direction:column;
    gap:10px;
}

.habit{
    display:flex;
    align-items:center;
    gap:15px;
    padding:15px;
    background:var(--card2);
    border:1px solid #242424;
    border-radius:10px;
    cursor:pointer;
}

.check{
    width:22px;
    height:22px;
    border:2px solid #444;
    border-radius:6px;
    display:flex;
    align-items:center;
    justify-content:center;
    flex-shrink:0;
}

.habit.done .check{
    background:var(--green);
    border-color:var(--green);
}

.habit.done .check:after{
    content:"✓";
    color:#000;
    font-weight:bold;
}

.habit.done .habit-name{
    color:#666;
    text-decoration:line-through;
}

.habit-info{
    flex:1;
}

.habit-name{
    font-weight:bold;
}

.habit-desc{
    color:#777;
    font-size:11px;
    margin-top:3px;
}

/* PROGRESS */

.progress{
    margin-top:20px;
}

.progress-top{
    display:flex;
    justify-content:space-between;
    margin-bottom:8px;
    font-size:13px;
}

.progress-bar{
    height:9px;
    background:#222;
    border-radius:20px;
    overflow:hidden;
}

.progress-fill{
    height:100%;
    width:0;
    background:linear-gradient(
        90deg,
        var(--orange),
        var(--orange2)
    );
    transition:.3s;
}

/* BODY */

.input-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:12px;
}

.input-box label{
    display:block;
    color:#777;
    font-size:10px;
    text-transform:uppercase;
    margin-bottom:6px;
}

.input-box input{
    width:100%;
    padding:13px;
    background:#0b0b0b;
    border:1px solid #333;
    border-radius:8px;
    color:white;
    outline:none;
}

.input-box input:focus{
    border-color:var(--orange);
}

/* EXERCISES */

.exercise-section{
    margin-top:30px;
}

.exercise-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:15px;
}

.exercise-card{
    background:var(--card);
    border:1px solid var(--border);
    border-radius:15px;
    padding:22px;
}

.exercise-icon{
    font-size:30px;
    margin-bottom:10px;
}

.exercise-name{
    font-size:19px;
    font-weight:900;
}

.exercise-sub{
    color:#777;
    font-size:11px;
    margin:5px 0 18px;
}

.rep-inputs{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
}

.rep-input label{
    display:block;
    color:#777;
    font-size:9px;
    text-transform:uppercase;
    margin-bottom:6px;
}

.rep-input input{
    width:100%;
    padding:12px;
    background:#0b0b0b;
    color:white;
    border:1px solid #333;
    border-radius:8px;
    outline:none;
}

.rep-input input:focus{
    border-color:var(--orange);
}

.exercise-progress{
    margin-top:16px;
}

.exercise-progress-top{
    display:flex;
    justify-content:space-between;
    color:#999;
    font-size:11px;
    margin-bottom:7px;
}

.exercise-bar{
    height:8px;
    background:#222;
    border-radius:20px;
    overflow:hidden;
}

.exercise-fill{
    width:0;
    height:100%;
    background:var(--green);
    transition:.3s;
}

.rep-total{
    color:#aaa;
    font-size:12px;
    margin-top:12px;
}

/* STATS */

.stats{
    display:grid;
    grid-template-columns:repeat(6,1fr);
    gap:15px;
    margin-top:20px;
}

.stat{
    background:var(--card);
    border:1px solid var(--border);
    padding:20px;
    border-radius:12px;
}

.stat-label{
    color:#777;
    font-size:10px;
    text-transform:uppercase;
}

.stat-value{
    font-size:24px;
    font-weight:900;
    margin-top:7px;
}

/* ==================================================
   COMPARISON
================================================== */

.comparison-section{
    margin-top:70px;
    padding-bottom:50px;
}

.comparison-header{
    margin-bottom:25px;
}

.comparison-title{
    font-size:clamp(32px,5vw,55px);
    font-weight:900;
    letter-spacing:-2px;
}

.comparison-title span{
    color:var(--orange);
}

.comparison-subtitle{
    color:#777;
    margin-top:8px;
}

/* NAME INPUTS */

.name-inputs{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
    margin-bottom:20px;
}

.name-box{
    background:var(--card);
    border:1px solid var(--border);
    border-radius:12px;
    padding:18px;
}

.name-box label{
    display:block;
    color:#777;
    font-size:10px;
    text-transform:uppercase;
    margin-bottom:8px;
}

.name-box input{
    width:100%;
    padding:13px;
    background:#0b0b0b;
    border:1px solid #333;
    border-radius:8px;
    color:white;
    font-size:16px;
    outline:none;
}

.name-box input:focus{
    border-color:var(--orange);
}

/* COMPARISON TABLE */

.comparison-card{
    background:var(--card);
    border:1px solid var(--border);
    border-radius:15px;
    overflow:hidden;
}

.comparison-grid{
    display:grid;
    grid-template-columns:1fr 1fr 1fr;
}

.comparison-cell{
    padding:20px;
    border-bottom:1px solid var(--border);
    border-right:1px solid var(--border);
    min-height:80px;
}

.comparison-cell:nth-child(3n){
    border-right:none;
}

.comparison-label{
    color:#777;
    font-size:11px;
    text-transform:uppercase;
    letter-spacing:1px;
}

.comparison-value{
    font-size:25px;
    font-weight:900;
    margin-top:8px;
}

.person1-header{
    color:#ff6a00;
    font-weight:900;
    font-size:18px;
}

.person2-header{
    color:#4da6ff;
    font-weight:900;
    font-size:18px;
}

.metric-name{
    font-weight:bold;
    font-size:14px;
}

/* OVERALL COMPARISON */

.compare-progress{
    margin-top:25px;
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
}

.compare-progress-card{
    background:var(--card);
    border:1px solid var(--border);
    border-radius:12px;
    padding:20px;
}

.compare-progress-name{
    display:flex;
    justify-content:space-between;
    margin-bottom:10px;
}

.compare-progress-bar{
    height:12px;
    background:#222;
    border-radius:20px;
    overflow:hidden;
}

.compare-progress-fill{
    height:100%;
    background:var(--orange);
    width:0;
    transition:.4s;
}

.person2-fill{
    background:#4da6ff;
}

/* PHASES */

.overview{
    margin:30px 0 60px;
}

.overview-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:15px;
}

.phase{
    background:var(--card);
    border:1px solid var(--border);
    border-radius:12px;
    padding:25px;
}

.phase-number{
    color:var(--orange);
    font-size:12px;
    font-weight:bold;
}

.phase h3{
    margin:12px 0;
}

.phase p{
    color:#777;
    font-size:13px;
    line-height:1.5;
}

/* MOBILE */

@media(max-width:900px){

    .dashboard{
        grid-template-columns:1fr;
    }

    .exercise-grid{
        grid-template-columns:1fr;
    }

    .stats{
        grid-template-columns:repeat(3,1fr);
    }

}

@media(max-width:650px){

    .day-grid{
        grid-template-columns:repeat(7,1fr);
    }

    .input-grid{
        grid-template-columns:1fr;
    }

    .stats{
        grid-template-columns:1fr 1fr;
    }

    .overview-grid{
        grid-template-columns:1fr;
    }

    .name-inputs{
        grid-template-columns:1fr;
    }

    .comparison-grid{
        grid-template-columns:1fr 1fr;
    }

    .comparison-cell{
        min-height:70px;
    }

    .comparison-cell:nth-child(3n){
        border-right:1px solid var(--border);
    }

    .comparison-cell:nth-child(2n){
        border-right:none;
    }

    .comparison-grid .metric-cell{
        grid-column:1 / -1;
    }

    .compare-progress{
        grid-template-columns:1fr;
    }

    .hero h1{
        letter-spacing:-3px;
    }

}

</style>
</head>


<body>

<header>

<div class="container nav">

    <div class="logo">
        WINTER<span>ARC</span>
    </div>

    <button
        class="reset"
        onclick="resetAll()">
        Reset
    </button>

</div>

</header>


<main class="container">


<!-- HERO -->

<section class="hero">

    <div class="eyebrow">
        90 DAY FAT LOSS CHALLENGE
    </div>

    <h1>
        BECOME<br>
        <span>LEANER.</span>
    </h1>

    <p>
        90 days. One mission.
        Build discipline, track your body,
        complete your workouts and finish
        the Winter Arc.
    </p>

</section>


<!-- PERSON SWITCH -->

<div class="person-switcher">

    <button
        class="person-btn active"
        id="person1Btn"
        onclick="switchPerson(1)">
        PERSON 1
    </button>

    <button
        class="person-btn"
        id="person2Btn"
        onclick="switchPerson(2)">
        PERSON 2
    </button>

</div>


<!-- DAYS -->

<section>

    <div class="section-title">
        Your 90 Days
    </div>

    <div
        class="day-grid"
        id="dayGrid">
    </div>

</section>


<!-- DASHBOARD -->

<section class="dashboard">


<!-- DAILY TRACKER -->

<div class="card">

    <div class="day-header">

        <div>

            <div class="card-title">
                Daily Mission
            </div>

            <div
                class="day-number"
                id="dayTitle">
                DAY 1
            </div>

        </div>

        <div
            class="date"
            id="dateDisplay">
            —
        </div>

    </div>


    <div class="habits">


        <div
            class="habit"
            data-habit="workout">

            <div class="check"></div>

            <div class="habit-info">

                <div class="habit-name">
                    Workout
                </div>

                <div class="habit-desc">
                    45–60 minutes training
                </div>

            </div>

        </div>


        <div
            class="habit"
            data-habit="steps">

            <div class="check"></div>

            <div class="habit-info">

                <div class="habit-name">
                    Steps
                </div>

                <div class="habit-desc">
                    8,000–10,000 steps
                </div>

            </div>

        </div>


        <div
            class="habit"
            data-habit="protein">

            <div class="check"></div>

            <div class="habit-info">

                <div class="habit-name">
                    Protein
                </div>

                <div class="habit-desc">
                    Hit your protein target
                </div>

            </div>

        </div>


        <div
            class="habit"
            data-habit="calories">

            <div class="check"></div>

            <div class="habit-info">

                <div class="habit-name">
                    Calories
                </div>

                <div class="habit-desc">
                    Stay around your calorie target
                </div>

            </div>

        </div>


        <div
            class="habit"
            data-habit="water">

            <div class="check"></div>

            <div class="habit-info">

                <div class="habit-name">
                    Water
                </div>

                <div class="habit-desc">
                    2–3 litres
                </div>

            </div>

        </div>


        <div
            class="habit"
            data-habit="sleep">

            <div class="check"></div>

            <div class="habit-info">

                <div class="habit-name">
                    Sleep
                </div>

                <div class="habit-desc">
                    7–9 hours
                </div>

            </div>

        </div>


        <div
            class="habit"
            data-habit="sugar">

            <div class="check"></div>

            <div class="habit-info">

                <div class="habit-name">
                    No Sugary Drinks
                </div>

                <div class="habit-desc">
                    Avoid unnecessary liquid calories
                </div>

            </div>

        </div>


    </div>


    <div class="progress">

        <div class="progress-top">

            <span>
                Daily Completion
            </span>

            <strong id="dailyPercent">
                0%
            </strong>

        </div>

        <div class="progress-bar">

            <div
                class="progress-fill"
                id="dailyProgress">
            </div>

        </div>

    </div>

</div>


<!-- BODY DATA -->

<div class="card">

    <div class="card-title">
        Body Progress
    </div>

    <div class="input-grid">


        <div class="input-box">

            <label>
                Weight KG
            </label>

            <input
                id="weight"
                type="number"
                step="0.1"
                placeholder="78.5">

        </div>


        <div class="input-box">

            <label>
                Waist CM
            </label>

            <input
                id="waist"
                type="number"
                step="0.1"
                placeholder="85">

        </div>


        <div class="input-box">

            <label>
                Steps
            </label>

            <input
                id="stepsInput"
                type="number"
                placeholder="8500">

        </div>


        <div class="input-box">

            <label>
                Water L
            </label>

            <input
                id="waterInput"
                type="number"
                step="0.1"
                placeholder="2.5">

        </div>


    </div>

</div>

</section>


<!-- EXERCISES -->

<section class="exercise-section">

    <div class="section-title">
        Daily Rep Tracker
    </div>


    <div class="exercise-grid">


        <!-- SQUATS -->

        <div class="exercise-card">

            <div class="exercise-icon">
                🦵
            </div>

            <div class="exercise-name">
                Squats
            </div>

            <div class="exercise-sub">
                Lower Body
            </div>


            <div class="rep-inputs">

                <div class="rep-input">

                    <label>
                        Daily Target
                    </label>

                    <input
                        id="squatTarget"
                        type="number"
                        min="0"
                        placeholder="50">

                </div>


                <div class="rep-input">

                    <label>
                        Completed
                    </label>

                    <input
                        id="squatCompleted"
                        type="number"
                        min="0"
                        placeholder="0">

                </div>

            </div>


            <div class="exercise-progress">

                <div class="exercise-progress-top">

                    <span>
                        Progress
                    </span>

                    <span id="squatPercent">
                        0%
                    </span>

                </div>

                <div class="exercise-bar">

                    <div
                        class="exercise-fill"
                        id="squatProgress">
                    </div>

                </div>

            </div>


            <div
                class="rep-total"
                id="squatText">
                0 / 50 reps
            </div>

        </div>


        <!-- PUSHUPS -->

        <div class="exercise-card">

            <div class="exercise-icon">
                💪
            </div>

            <div class="exercise-name">
                Push-ups
            </div>

            <div class="exercise-sub">
                Upper Body
            </div>


            <div class="rep-inputs">

                <div class="rep-input">

                    <label>
                        Daily Target
                    </label>

                    <input
                        id="pushTarget"
                        type="number"
                        min="0"
                        placeholder="40">

                </div>


                <div class="rep-input">

                    <label>
                        Completed
                    </label>

                    <input
                        id="pushCompleted"
                        type="number"
                        min="0"
                        placeholder="0">

                </div>

            </div>


            <div class="exercise-progress">

                <div class="exercise-progress-top">

                    <span>
                        Progress
                    </span>

                    <span id="pushPercent">
                        0%
                    </span>

                </div>

                <div class="exercise-bar">

                    <div
                        class="exercise-fill"
                        id="pushProgress">
                    </div>

                </div>

            </div>


            <div
                class="rep-total"
                id="pushText">
                0 / 40 reps
            </div>

        </div>


        <!-- ABS -->

        <div class="exercise-card">

            <div class="exercise-icon">
                🔥
            </div>

            <div class="exercise-name">
                Abs
            </div>

            <div class="exercise-sub">
                Core
            </div>


            <div class="rep-inputs">

                <div class="rep-input">

                    <label>
                        Daily Target
                    </label>

                    <input
                        id="absTarget"
                        type="number"
                        min="0"
                        placeholder="30">

                </div>


                <div class="rep-input">

                    <label>
                        Completed
                    </label>

                    <input
                        id="absCompleted"
                        type="number"
                        min="0"
                        placeholder="0">

                </div>

            </div>


            <div class="exercise-progress">

                <div class="exercise-progress-top">

                    <span>
                        Progress
                    </span>

                    <span id="absPercent">
                        0%
                    </span>

                </div>

                <div class="exercise-bar">

                    <div
                        class="exercise-fill"
                        id="absProgress">
                    </div>

                </div>

            </div>


            <div
                class="rep-total"
                id="absText">
                0 / 30 reps
            </div>

        </div>


    </div>

</section>


<!-- PERSONAL STATS -->

<section class="stats">


    <div class="stat">

        <div class="stat-label">
            Days Complete
        </div>

        <div
            class="stat-value"
            id="daysComplete">
            0
        </div>

    </div>


    <div class="stat">

        <div class="stat-label">
            Current Streak
        </div>

        <div
            class="stat-value"
            id="streak">
            0
        </div>

    </div>


    <div class="stat">

        <div class="stat-label">
            Current Weight
        </div>

        <div
            class="stat-value"
            id="currentWeight">
            —
        </div>

    </div>


    <div class="stat">

        <div class="stat-label">
            Overall Progress
        </div>

        <div
            class="stat-value"
            id="overallProgress">
            0%
        </div>

    </div>


    <div class="stat">

        <div class="stat-label">
            Total Squats
        </div>

        <div
            class="stat-value"
            id="totalSquats">
            0
        </div>

    </div>


    <div class="stat">

        <div class="stat-label">
            Total Push-ups
        </div>

        <div
            class="stat-value"
