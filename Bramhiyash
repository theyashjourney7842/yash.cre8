<script>

/* ==================================================
   SETTINGS
================================================== */

const TOTAL_DAYS = 90;

let currentDay = 1;

let currentPerson = 1;


/* ==================================================
   DEFAULT DATA
================================================== */

function createEmptyPerson(){

    const person = {

        startDate:new Date().toISOString(),

        days:{}

    };

    for(
        let i=1;
        i<=TOTAL_DAYS;
        i++
    ){

        person.days[i] = {

            habits:{

                workout:false,
                steps:false,
                protein:false,
                calories:false,
                water:false,
                sleep:false,
                sugar:false

            },

            weight:"",
            waist:"",
            steps:"",
            water:"",

            exercises:{

                squats:{
                    target:50,
                    completed:0
                },

                pushups:{
                    target:40,
                    completed:0
                },

                abs:{
                    target:30,
                    completed:0
                }

            }

        };

    }

    return person;

}


/* ==================================================
   LOAD MAIN DATABASE
================================================== */

let database =
    JSON.parse(
        localStorage.getItem(
            "winterArcPeople"
        )
    );


if(!database){

    database = {

        person1:createEmptyPerson(),

        person2:createEmptyPerson(),

        names:{
            person1:"Person 1",
            person2:"Person 2"
        }

    };

    saveDatabase();

}


/* ==================================================
   SAVE DATABASE
================================================== */

function saveDatabase(){

    localStorage.setItem(
        "winterArcPeople",
        JSON.stringify(database)
    );

}


/* ==================================================
   CURRENT PERSON
================================================== */

function getPerson(){

    return currentPerson===1
        ?database.person1
        :database.person2;

}


/* ==================================================
   SWITCH PERSON
================================================== */

function switchPerson(person){

    currentPerson=person;

    document
        .getElementById("person1Btn")
        .classList.toggle(
            "active",
            person===1
        );

    document
        .getElementById("person2Btn")
        .classList.toggle(
            "active",
            person===2
        );

    loadDay();

    updateStats();

    updateComparison();

}


/* ==================================================
   LOAD DAY
================================================== */

function loadDay(){

    const person=getPerson();

    const day=person.days[currentDay];


    document.getElementById(
        "dayTitle"
    ).textContent=
        "DAY "+currentDay;


    const start=
        new Date(person.startDate);

    const date=
        new Date(start);

    date.setDate(
        start.getDate()+
        currentDay-
        1
    );


    document.getElementById(
        "dateDisplay"
    ).textContent=
        date.toLocaleDateString(
            "en-IN",
            {
                day:"numeric",
                month:"short",
                year:"numeric"
            }
        );


    /* HABITS */

    document
        .querySelectorAll(".habit")
        .forEach(habit=>{

            const name=
                habit.dataset.habit;

            habit.classList.toggle(
                "done",
                day.habits[name]
            );

        });


    /* BODY */

    document.getElementById(
        "weight"
    ).value=day.weight;

    document.getElementById(
        "waist"
    ).value=day.waist;

    document.getElementById(
        "stepsInput"
    ).value=day.steps;

    document.getElementById(
        "waterInput"
    ).value=day.water;


    /* EXERCISES */

    document.getElementById(
        "squatTarget"
    ).value=
        day.exercises.squats.target;

    document.getElementById(
        "squatCompleted"
    ).value=
        day.exercises.squats.completed;


    document.getElementById(
        "pushTarget"
    ).value=
        day.exercises.pushups.target;

    document.getElementById(
        "pushCompleted"
    ).value=
        day.exercises.pushups.completed;


    document.getElementById(
        "absTarget"
    ).value=
        day.exercises.abs.target;

    document.getElementById(
        "absCompleted"
    ).value=
        day.exercises.abs.completed;


    updateDailyProgress();

    updateExerciseProgress();

    updateDayButtons();

}


/* ==================================================
   DAY BUTTONS
================================================== */

function createDayButtons(){

    const grid=
        document.getElementById(
            "dayGrid"
        );

    grid.innerHTML="";


    for(
        let i=1;
        i<=TOTAL_DAYS;
        i++
    ){

        const button=
            document.createElement(
                "button"
            );

        button.className="day";

        button.textContent=i;

        button.onclick=()=>{

            currentDay=i;

            loadDay();

        };

        grid.appendChild(button);

    }

}


/* ==================================================
   DAY COMPLETE
================================================== */

function isDayComplete(
    person,
    dayNumber
){

    const day=
        person.days[dayNumber];


    const habitsComplete=
        Object.values(day.habits)
        .every(Boolean);


    const exercisesComplete=

        day.exercises.squats.completed
        >=
        day.exercises.squats.target

        &&

        day.exercises.pushups.completed
        >=
        day.exercises.pushups.target

        &&

        day.exercises.abs.completed
        >=
        day.exercises.abs.target;


    return habitsComplete &&
           exercisesComplete;

}


/* ==================================================
   DAY BUTTON COLORS
================================================== */

function updateDayButtons(){

    const person=getPerson();


    document
        .querySelectorAll(".day")
        .forEach(
            (button,index)=>{

                const day=index+1;

                button.classList.remove(
                    "active",
                    "completed"
                );


                if(day===currentDay){

                    button.classList.add(
                        "active"
                    );

                }


                if(
                    isDayComplete(
                        person,
                        day
                    )
                ){

                    button.classList.add(
                        "completed"
                    );

                }

            }
        );

}


/* ==================================================
   HABIT CLICK
================================================== */

document
    .querySelectorAll(".habit")
    .forEach(habit=>{

        habit.addEventListener(
            "click",
            ()=>{

                const person=
                    getPerson();

                const name=
                    habit.dataset.habit;


                person.days[currentDay]
                    .habits[name]=
                    !person.days[currentDay]
                    .habits[name];


                saveDatabase();

                loadDay();

                updateStats();

                updateComparison();

            }
        );

    });


/* ==================================================
   DAILY PROGRESS
================================================== */

function updateDailyProgress(){

    const person=getPerson();

    const day=
        person.days[currentDay];


    const habits=
        Object.values(
            day.habits
        );


    const habitScore=
        habits.filter(Boolean)
        .length;


    let exerciseScore=0;


    if(
        day.exercises.squats.target>0
    ){

        exerciseScore+=Math.min(
            day.exercises.squats.completed/
            day.exercises.squats.target,
            1
        );

    }


    if(
        day.exercises.pushups.target>0
    ){

        exerciseScore+=Math.min(
            day.exercises.pushups.completed/
            day.exercises.pushups.target,
            1
        );

    }


    if(
        day.exercises.abs.target>0
    ){

        exerciseScore+=Math.min(
            day.exercises.abs.completed/
            day.exercises.abs.target,
            1
        );

    }


    const total=
        habits.length+3;


    const completed=
        habitScore+
        exerciseScore;


    const percent=
        Math.round(
            completed/
            total*
            100
        );


    document.getElementById(
        "dailyPercent"
    ).textContent=
        percent+"%";


    document.getElementById(
        "dailyProgress"
    ).style.width=
        percent+"%";

}


/* ==================================================
   EXERCISE PROGRESS
================================================== */

function updateExerciseProgress(){

    const person=getPerson();

    const exercises=
        person.days[currentDay]
        .exercises;


    updateExercise(
        exercises.squats,
        "squat"
    );

    updateExercise(
        exercises.pushups,
        "push"
    );

    updateExercise(
        exercises.abs,
        "abs"
    );

}


function updateExercise(
    exercise,
    prefix
){

    let percent=0;


    if(exercise.target>0){

        percent=
            Math.min(
                Math.round(
                    exercise.completed/
                    exercise.target*
                    100
                ),
                100
            );

    }


    document.getElementById(
        prefix+"Percent"
    ).textContent=
        percent+"%";


    document.getElementById(
        prefix+"Progress"
    ).style.width=
        percent+"%";


    document.getElementById(
        prefix+"Text"
    ).textContent=
        exercise.completed+
        " / "+
        exercise.target+
        " reps";

}


/* ==================================================
   EXERCISE INPUTS
================================================== */

const exerciseMap={

    squatTarget:[
        "squats",
        "target"
    ],

    squatCompleted:[
        "squats",
        "completed"
    ],

    pushTarget:[
        "pushups",
        "target"
    ],

    pushCompleted:[
        "pushups",
        "completed"
    ],

    absTarget:[
        "abs",
        "target"
    ],

    absCompleted:[
        "abs",
        "completed"
    ]

};


Object.keys(exerciseMap)
.forEach(id=>{

    document
        .getElementById(id)
        .addEventListener(
            "input",
            function(){

                const person=
                    getPerson();

                const [
                    exercise,
                    property
                ]=
                    exerciseMap[id];


                let value=
                    parseInt(
                        this.value
                    )||0;


                if(value<0)
                    value=0;


                person.days[currentDay]
                    .exercises
                    [exercise]
                    [property]=
                    value;


                saveDatabase();

                updateExerciseProgress();

                updateDailyProgress();

                updateStats();

                updateComparison();

            }
        );

});


/* ==================================================
   BODY INPUTS
================================================== */

const bodyMap={

    weight:"weight",

    waist:"waist",

    stepsInput:"steps",

    waterInput:"water"

};


Object.keys(bodyMap)
.forEach(id=>{

    document
        .getElementById(id)
        .addEventListener(
            "input",
            function(){

                const person=
                    getPerson();


                person.days[currentDay]
                    [bodyMap[id]]=
                    this.value;


                saveDatabase();

                updateStats();

                updateComparison();

            }
        );

});


/* ==================================================
   STATS
================================================== */

function calculatePersonStats(person){

    let completedDays=0;

    let lastWeight="";

    let lastWaist="";

    let totalSquats=0;

    let totalPushups=0;

    let totalAbs=0;


    for(
        let i=1;
        i<=TOTAL_DAYS;
        i++
    ){

        const day=
            person.days[i];


        if(
            isDayComplete(
                person,
                i
            )
        ){

            completedDays++;

        }


        if(day.weight!==""){

            lastWeight=
                day.weight;

        }


        if(day.waist!==""){

            lastWaist=
                day.waist;

        }


        totalSquats+=
            Number(
                day.exercises
                .squats
                .completed
            )||0;


        totalPushups+=
            Number(
                day.exercises
                .pushups
                .completed
            )||0;


        totalAbs+=
            Number(
                day.exercises
                .abs
                .completed
            )||0;

    }


    let streak=0;


    for(
        let i=TOTAL_DAYS;
        i>=1;
        i--
    ){

        if(
            isDayComplete(
                person,
                i
            )
        ){

            streak++;

        }else{

            break;

        }

    }


    return {

        completedDays,

        weight:lastWeight,

        waist:lastWaist,

        totalSquats,

        totalPushups,

        totalAbs,

        streak,

        progress:
            Math.round(
                completedDays/
                TOTAL_DAYS*
                100
            )

    };

}


/* ==================================================
   PERSONAL STATS
================================================== */

function updateStats(){

    const person=getPerson();

    const stats=
        calculatePersonStats(
            person
        );


    document.getElementById(
        "daysComplete"
    ).textContent=
        stats.completedDays;


    document.getElementById(
        "streak"
    ).textContent=
        stats.streak;


    document.getElementById(
        "currentWeight"
    ).textContent=
        stats.weight
        ?stats.weight+" kg"
        :"—";


    document.getElementById(
        "overallProgress"
    ).textContent=
        stats.progress+"%";


    document.getElementById(
        "totalSquats"
    ).textContent=
        stats.totalSquats
        .toLocaleString();


    document.getElementById(
        "totalPushups"
    ).textContent=
        stats.totalPushups
        .toLocaleString();


    updateDayButtons();

}


/* ==================================================
   NAMES
================================================== */

function saveNames(){

    const name1=
        document.getElementById(
            "person1Name"
        ).value.trim();


    const name2=
        document.getElementById(
            "person2Name"
        ).value.trim();


    database.names.person1=
        name1||"Person 1";


    database.names.person2=
        name2||"Person 2";


    saveDatabase();

    updateComparison();

}


/* ==================================================
   COMPARISON
================================================== */

function updateComparison(){

    const stats1=
        calculatePersonStats(
            database.person1
        );


    const stats2=
        calculatePersonStats(
            database.person2
        );


    const name1=
        database.names.person1||
        "Person 1";


    const name2=
        database.names.person2||
        "Person 2";


    document.getElementById(
        "person1Name"
    ).value=
        name1==="Person 1"
        ?""
        :name1;


    document.getElementById(
        "person2Name"
    ).value=
        name2==="Person 2"
        ?""
        :name2;


    document.getElementById(
        "comparePerson1Name"
    ).textContent=
        name1;


    document.getElementById(
        "comparePerson2Name"
    ).textContent=
        name2;


    /* WEIGHT */

    document.getElementById(
        "compareWeight1"
    ).textContent=
        stats1.weight
        ?stats1.weight+" kg"
        :"—";


    document.getElementById(
        "compareWeight2"
    ).textContent=
        stats2.weight
        ?stats2.weight+" kg"
        :"—";


    /* WAIST */

    document.getElementById(
        "compareWaist1"
    ).textContent=
        stats1.waist
        ?stats1.waist+" cm"
        :"—";


    document.getElementById(
        "compareWaist2"
    ).textContent=
        stats2.waist
        ?stats2.waist+" cm"
        :"—";


    /* SQUATS */

    document.getElementById(
        "compareSquats1"
    ).textContent=
        stats1.totalSquats
        .toLocaleString();


    document.getElementById(
        "compareSquats2"
    ).textContent=
        stats2.totalSquats
        .toLocaleString();


    /* PUSHUPS */

    document.getElementById(
        "comparePush1"
    ).textContent=
        stats1.totalPushups
        .toLocaleString();


    document.getElementById(
        "comparePush2"
    ).textContent=
        stats2.totalPushups
        .toLocaleString();


    /* ABS */

    document.getElementById(
        "compareAbs1"
    ).textContent=
        stats1.totalAbs
        .toLocaleString();


    document.getElementById(
        "compareAbs2"
    ).textContent=
        stats2.totalAbs
        .toLocaleString();


    /* DAYS */

    document.getElementById(
        "compareDays1"
    ).textContent=
        stats1.completedDays+
        " / 90";


    document.getElementById(
        "compareDays2"
    ).textContent=
        stats2.completedDays+
        " / 90";


    /* STREAK */

    document.getElementById(
        "compareStreak1"
    ).textContent=
        stats1.streak;


    document.getElementById(
        "compareStreak2"
    ).textContent=
        stats2.streak;


    /* PROGRESS */

    document.getElementById(
        "compareProgress1"
    ).textContent=
        stats1.progress+"%";


    document.getElementById(
        "compareProgress2"
    ).textContent=
        stats2.progress+"%";


    /* BARS */

    document.getElementById(
        "progressName1"
    ).textContent=
        name1;


    document.getElementById(
        "progressName2"
    ).textContent=
        name2;


    document.getElementById(
        "progressValue1"
    ).textContent=
        stats1.progress+"%";


    document.getElementById(
        "progressValue2"
    ).textContent=
        stats2.progress+"%";


    document.getElementById(
        "progressBar1"
    ).style.width=
        stats1.progress+"%";


    document.getElementById(
        "progressBar2"
    ).style.width=
        stats2.progress+"%";

}


